+        check(zero(state, sizeof(*state)));
+        if (frames.size() > 1)
+            check(std::memcmp(&frames.back().parent, frames[frames.size() - 2].state, sizeof(*state)) == 0);
+        { std::lock_guard<std::mutex> guard(lock); check(active.erase(state) == 1); }
+        frames.pop_back();
+        ++counts[3];
+    }
