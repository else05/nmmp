# KEY=VALUE, one item per line. Do not add quotes.
JAVA_HOME=E:\Scoop\apps\temurin21-jdk\current
JAVA_EXE=E:\Scoop\apps\temurin21-jdk\current\bin\java.exe
ANDROID_HOME=D:\Android\SDK
ANDROID_SDK_HOME=D:\Android\SDK
ANDROID_NDK_HOME=D:\Android\SDK\ndk\27.0.12077973
CMAKE_PATH=D:\Android\SDK\cmake\3.22.1
CMAKE_BUILD_PARALLEL_LEVEL=6

NMMP_PROJECT_ROOT=E:\OtherProject\safe-toolchain\nmmp
NMMP_JAR=D:\Android\SDK_WSL\nmmp\vm-protect.jar
NMMP_DEPLOY_JAR=D:\Android\SDK_WSL\nmmp\vm-protect.jar

# Optional override. Leave both empty to use the default pair beside nmmp.cmd.
# Custom keys must be DER PKCS#8 and DER X.509 Ed25519 files.
NMMP_ARTIFACT_PRIVATE_KEY=
NMMP_ARTIFACT_PUBLIC_KEY=

# observe or enforce
NMMP_PROTECTION_PROFILE=enforce

# true or false; keep false for production.
NMMP_DIAGNOSTICS=false

# Optional UTF-8 file containing at most 20 exact DEX method descriptors.
NMMP_SENSITIVE_METHODS_FILE=

# Test only: exactly 16 hexadecimal characters. Leave empty for production.
NMMP_TEST_SEED=
